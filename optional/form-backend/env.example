# Copy to .env for local runs only. Never commit real values. On Cloudflare Pages set these in Settings > Variables and Secrets (Secrets for the SECRET/KEY ones).
# Names only; every value below is a placeholder.

# BUILD TIME (public value, safe in the page source). Leave empty to build the form without the Turnstile widget.
TURNSTILE_SITEKEY=

# RUNTIME, secret. Required for the form functions in api/.
FORM_SECRET=            # random string, 32+ bytes. Signs the time-check token.
TURNSTILE_SECRET=       # Cloudflare Turnstile secret key for the widget above.
RESEND_API_KEY=         # Resend API key (free plan: 100 emails/day, 3,000/month), sending access only, restricted to the nynz.in domain.
# Rate limiting on Cloudflare Pages: bind a Workers KV namespace to the variable name RL (Settings > Bindings). No env value needed.

# RUNTIME, optional
ALLOWED_ORIGINS=https://nynz.in   # Production. For Preview scope use: https://nynz.in,.pages.dev
MAIL_TO=sales@nynz.in
MAIL_FROM=NYNZ website <forms@nynz.in>
# RATE_LIMIT_STORE=memory         # local runs only, never in production
